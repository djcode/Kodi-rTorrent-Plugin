msgctxt "Addon Summary"
msgid "rTorrent Control Plugin"
msgstr "rTorrent – wtyczka sterowania"

msgctxt "Addon Description"
msgid "A simple plugin for interacting with rTorrent over HTTP or SCGI."
msgstr "Prosta wtyczka umożliwiająca interakcję z rTorrentem przez HTTP lub SCGI."

msgctxt "Addon Disclaimer"
msgid "Requires an rTorrent instance with XMLRPC enabled."
msgstr "Wymagana jest instancja rTorrenta z włączoną obsługą XMLRPC."

# --- SETTINGS START
msgctxt "#30000"
msgid "URI"
msgstr "Adres URI"

msgctxt "#30001"
msgid ""
"SCGI and HTTP protocols supported.\n"
"Examples: http://host:port, scgi://host:port, scgi:///path/to/socket"
msgstr ""
"Obsługiwane są protokoły SCGI i HTTP.\n"
"Przykłady: http://host:port, scgi://host:port, scgi:///ścieżka/do/gniazdka"

msgctxt "#30004"
msgid "Downloading"
msgstr "Pobieranie"

msgctxt "#30005"
msgid "Complete"
msgstr "Ukończone"

msgctxt "#30040"
msgid "Remote Folders (If rTorrent is on a remote computer)"
msgstr "Foldery zdalne (jeśli rTorrent znajduje się na komputerze zdalnym)"

msgctxt "#30080"
msgid "Connection"
msgstr "Połączenie"

msgctxt "#30081"
msgid "Remote"
msgstr "Zdalne"

# --- SETTINGS END
# --- CONTEXT MENU START
msgctxt "#30100"
msgid "Start Download"
msgstr "Rozpocznij pobieranie"

msgctxt "#30101"
msgid "Stop Download"
msgstr "Zakończ pobieranie"

msgctxt "#30102"
msgid "Erase Download"
msgstr "Wymaż pobieranie"

msgctxt "#30120"
msgid "Set Priority: High"
msgstr "Ustaw priorytet: wysoki"

msgctxt "#30121"
msgid "Set Priority: Normal"
msgstr "Ustaw priorytet: zwykły"

msgctxt "#30122"
msgid "Set Priority: Low"
msgstr "Ustaw priorytet: niski"

msgctxt "#30123"
msgid "Set Priority: Idle"
msgstr "Ustaw priorytet: bezczynny"

msgctxt "#30124"
msgid "Set Priority: Don't Download"
msgstr "Ustaw priorytet: nie pobieraj"

msgctxt "#30150"
msgid "Play File"
msgstr "Odtwórz plik"

# --- CONTEXT MENU END
# --- WARNING DIALOG START
msgctxt "#30151"
msgid "This file has not downloaded completely."
msgstr "Plik nie został w całości pobrany."

msgctxt "#30152"
msgid "Are you sure you want to play it?"
msgstr "Czy na pewno chcesz go odtworzyć?"

msgctxt "#30153"
msgid "Delete Download"
msgstr "Usuń pobranie"

msgctxt "#30154"
msgid "Are you sure you want to delete this download?"
msgstr "Czy na pewno chcesz usunąć to pobranie?"

# --- WARNING DIALOG END
# --- ERROR DIALOG START
msgctxt "#30900"
msgid "Error!"
msgstr "Błąd!"

msgctxt "#30901"
msgid "Unable to play file."
msgstr "Nie można odtworzyć pliku."

msgctxt "#30902"
msgid "Connection Failed"
msgstr "Połączenie nieudane"

msgctxt "#30903"
msgid "Check settings..."
msgstr "Sprawdź ustawienia..."

msgctxt "#30904"
msgid "Exit"
msgstr "Wyjdź"

msgctxt "#30905"
msgid "Something went wrong."
msgstr "Coś poszło nie tak."

msgctxt "#30906"
msgid "An XMLRPC protocol error occurred. Submit a bug report!"
msgstr "Wystąpił błąd protokołu XMLRPC. Prześlij raport o błędzie!"

msgctxt "#30907"
msgid "An XMLRPC fault occurred. Submit a bug report!"
msgstr "Wystąpił błąd XMLRPC. Zgłoś błąd!"

msgctxt "#30908"
msgid "Connection to rTorrent refused. Check firewall settings."
msgstr "Połączenie z rTorrentem zostało odrzucone. Sprawdź ustawienia zapory sieciowej."

msgctxt "#30909"
msgid "Connection to rTorrent timed out. Check the host is correct."
msgstr "Połączenie z rTorrentem przekroczyło limit czasu. Sprawdź, czy host jest poprawny."

msgctxt "#30910"
msgid "Unexpected error occurred."
msgstr "Wystąpił nieoczekiwany błąd."
