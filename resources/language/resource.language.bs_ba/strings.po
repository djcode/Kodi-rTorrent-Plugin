msgctxt "Addon Summary"
msgid "rTorrent Control Plugin"
msgstr "rTorrent kontrolni dodatak"

msgctxt "Addon Description"
msgid "A simple plugin for interacting with rTorrent over HTTP or SCGI."
msgstr "Jednostavan dodatak za interakciju sa rTorrentom preko HTTP-a ili SCGI-ja."

msgctxt "Addon Disclaimer"
msgid "Requires an rTorrent instance with XMLRPC enabled."
msgstr "Zahtijeva rTorrent instancu sa omogućenim XMLRPC-om."

# --- SETTINGS START
msgctxt "#30000"
msgid "URI"
msgstr "URI"

msgctxt "#30001"
msgid ""
"SCGI and HTTP protocols supported.\n"
"Examples: http://host:port, scgi://host:port, scgi:///path/to/socket"
msgstr ""
"Podržani su SCGI i HTTP protokoli.\n"
"Primjeri: http://host:port, scgi://host:port, scgi:///putanja/do/socketa"

msgctxt "#30004"
msgid "Downloading"
msgstr "Preuzima se"

msgctxt "#30005"
msgid "Complete"
msgstr "Završeno"

msgctxt "#30040"
msgid "Remote Folders (If rTorrent is on a remote computer)"
msgstr "Udaljene mape (ako se rTorrent nalazi na udaljenom računaru)"

msgctxt "#30080"
msgid "Connection"
msgstr "Veza"

msgctxt "#30081"
msgid "Remote"
msgstr "Daljinski"

# --- SETTINGS END
# --- CONTEXT MENU START
msgctxt "#30100"
msgid "Start Download"
msgstr "Pokrenite preuzimanje"

msgctxt "#30101"
msgid "Stop Download"
msgstr "Zaustavi preuzimanje"

msgctxt "#30102"
msgid "Erase Download"
msgstr "Obriši preuzimanje"

msgctxt "#30120"
msgid "Set Priority: High"
msgstr "Postavi prioritet: Visok"

msgctxt "#30121"
msgid "Set Priority: Normal"
msgstr "Postavi prioritet: Normalno"

msgctxt "#30122"
msgid "Set Priority: Low"
msgstr "Postavi prioritet: Nizak"

msgctxt "#30123"
msgid "Set Priority: Idle"
msgstr "Postavi prioritet: Neaktivan"

msgctxt "#30124"
msgid "Set Priority: Don't Download"
msgstr "Postavi prioritet: Ne preuzimaj"

msgctxt "#30150"
msgid "Play File"
msgstr "Reproduciraj datoteku"

# --- CONTEXT MENU END
# --- WARNING DIALOG START
msgctxt "#30151"
msgid "This file has not downloaded completely."
msgstr "Ova datoteka nije u potpunosti preuzeta."

msgctxt "#30152"
msgid "Are you sure you want to play it?"
msgstr "Jesi li siguran/sigurna da želiš da to igraš?"

msgctxt "#30153"
msgid "Delete Download"
msgstr "Izbriši preuzimanje"

msgctxt "#30154"
msgid "Are you sure you want to delete this download?"
msgstr "Jeste li sigurni da želite izbrisati ovo preuzimanje?"

# --- WARNING DIALOG END
# --- ERROR DIALOG START
msgctxt "#30900"
msgid "Error!"
msgstr "Greška!"

msgctxt "#30901"
msgid "Unable to play file."
msgstr "Nije moguće reproducirati datoteku."

msgctxt "#30902"
msgid "Connection Failed"
msgstr "Povezivanje nije uspjelo"

msgctxt "#30903"
msgid "Check settings..."
msgstr "Provjeri postavke..."

msgctxt "#30904"
msgid "Exit"
msgstr "Izlaz"

msgctxt "#30905"
msgid "Something went wrong."
msgstr "Izvinite, ali nešto je pošlo po zlu."

msgctxt "#30906"
msgid "An XMLRPC protocol error occurred. Submit a bug report!"
msgstr "Došlo je do greške XMLRPC protokola. Pošaljite izvještaj o grešci!"

msgctxt "#30907"
msgid "An XMLRPC fault occurred. Submit a bug report!"
msgstr "Došlo je do greške XMLRPC-a. Pošaljite izvještaj o grešci!"

msgctxt "#30908"
msgid "Connection to rTorrent refused. Check firewall settings."
msgstr "Veza sa rTorrentom odbijena. Provjerite postavke zaštitnog zida (firewall-a)."

msgctxt "#30909"
msgid "Connection to rTorrent timed out. Check the host is correct."
msgstr "Vremensko ograničenje veze sa rTorrentom je isteklo. Provjerite da li je host ispravan."

msgctxt "#30910"
msgid "Unexpected error occurred."
msgstr "Došlo je do neočekivane greške."
