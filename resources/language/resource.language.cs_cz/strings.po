msgctxt "Addon Summary"
msgid "rTorrent Control Plugin"
msgstr "Plugin pro ovládání rTorrentu"

msgctxt "Addon Description"
msgid "A simple plugin for interacting with rTorrent over HTTP or SCGI."
msgstr "Jednoduchý plugin pro ovládání rTorrentu přes HTTP nebo SCGI."

msgctxt "Addon Disclaimer"
msgid "Requires an rTorrent instance with XMLRPC enabled."
msgstr "Vyžaduje instanci rTorrentu s povoleným XMLRPC."

# --- SETTINGS START
msgctxt "#30000"
msgid "URI"
msgstr "URI"

msgctxt "#30001"
msgid ""
"SCGI and HTTP protocols supported.\n"
"Examples: http://host:port, scgi://host:port, scgi:///path/to/socket"
msgstr ""
"Jsou podporovány protokoly SCGI a HTTP.\n"
"Příklady: http://host:port, scgi://host:port, scgi:///path/to/socket"

msgctxt "#30004"
msgid "Downloading"
msgstr "Stahované"

msgctxt "#30005"
msgid "Complete"
msgstr "Dokončené"

msgctxt "#30040"
msgid "Remote Folders (If rTorrent is on a remote computer)"
msgstr "Vzdálené složky (pokud rTorrent běží na vzdáleném počítači)"

msgctxt "#30080"
msgid "Connection"
msgstr "Připojení"

msgctxt "#30081"
msgid "Remote"
msgstr "Vzdálené"

# --- SETTINGS END
# --- CONTEXT MENU START
msgctxt "#30100"
msgid "Start Download"
msgstr "Spustit stahování"

msgctxt "#30101"
msgid "Stop Download"
msgstr "Zastavit stahování"

msgctxt "#30102"
msgid "Erase Download"
msgstr "Odstranit stahování"

msgctxt "#30120"
msgid "Set Priority: High"
msgstr "Nastavit prioritu: Vysoká"

msgctxt "#30121"
msgid "Set Priority: Normal"
msgstr "Nastavit prioritu: Normální"

msgctxt "#30122"
msgid "Set Priority: Low"
msgstr "Nastavit prioritu: Nízká"

msgctxt "#30123"
msgid "Set Priority: Idle"
msgstr "Nastavit prioritu: Nečinná"

msgctxt "#30124"
msgid "Set Priority: Don't Download"
msgstr "Nastavit prioritu: Nestahovat"

msgctxt "#30150"
msgid "Play File"
msgstr "Přehrát soubor"

# --- CONTEXT MENU END
# --- WARNING DIALOG START
msgctxt "#30151"
msgid "This file has not downloaded completely."
msgstr "Tento soubor ještě není zcela stažen."

msgctxt "#30152"
msgid "Are you sure you want to play it?"
msgstr "Opravdu ho chcete přehrát?"

msgctxt "#30153"
msgid "Delete Download"
msgstr "Odstranit stahování"

msgctxt "#30154"
msgid "Are you sure you want to delete this download?"
msgstr "Opravdu chcete toto stahování odstranit?"

# --- WARNING DIALOG END
# --- ERROR DIALOG START
msgctxt "#30900"
msgid "Error!"
msgstr "Chyba!"

msgctxt "#30901"
msgid "Unable to play file."
msgstr "Soubor nelze přehrát."

msgctxt "#30902"
msgid "Connection Failed"
msgstr "Připojení se nezdařilo"

msgctxt "#30903"
msgid "Check settings..."
msgstr "Zkontrolujte nastavení..."

msgctxt "#30904"
msgid "Exit"
msgstr "Ukončit"

msgctxt "#30905"
msgid "Something went wrong."
msgstr "Něco se nepodařilo."

msgctxt "#30906"
msgid "An XMLRPC protocol error occurred. Submit a bug report!"
msgstr "Došlo k chybě protokolu XMLRPC. Odešlete hlášení o chybě!"

msgctxt "#30907"
msgid "An XMLRPC fault occurred. Submit a bug report!"
msgstr "Došlo k chybě XMLRPC. Odešlete hlášení o chybě!"

msgctxt "#30908"
msgid "Connection to rTorrent refused. Check firewall settings."
msgstr "Připojení k rTorrentu bylo odmítnuto. Zkontrolujte nastavení firewallu."

msgctxt "#30909"
msgid "Connection to rTorrent timed out. Check the host is correct."
msgstr "Vypršel časový limit připojení k rTorrentu. Zkontrolujte, zda je hostitel správně zadán."

msgctxt "#30910"
msgid "Unexpected error occurred."
msgstr "Došlo k neočekávané chybě."
